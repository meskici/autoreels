# All optional. autoreels runs keyless with template scripting and silent
# voiceover; each key below upgrades one stage.

# --- Product ingest ---------------------------------------------------------
# Skip these and use `--product-json <file>` instead (e.g. Shopify MCP output).
SHOPIFY_STORE=kapyacraft.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-01

# --- Scriptwriting ----------------------------------------------------------
# Without this, autoreels falls back to the built-in template writer.
ANTHROPIC_API_KEY=sk-ant-xxx
AUTOREELS_MODEL=claude-opus-5

# --- Voiceover --------------------------------------------------------------
# AUTOREELS_TTS: auto | elevenlabs | openai | none
AUTOREELS_TTS=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=

# --- Render -----------------------------------------------------------------
AUTOREELS_FONT=DejaVu Sans
AUTOREELS_MUSIC_VOLUME=0.12
