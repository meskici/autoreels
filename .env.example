# All optional. autoreels runs keyless with template scripting and silent
# voiceover; each key below upgrades one stage.

# --- Product ingest ---------------------------------------------------------
# Skip these and use `--product-json <file>` instead (e.g. Shopify MCP output).
SHOPIFY_STORE=kapyacraft.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-01

# --- Scriptwriting ----------------------------------------------------------
# Without this, autoreels falls back to the built-in template writer.
ANTHROPIC_API_KEY=sk-ant-xxx
AUTOREELS_MODEL=claude-opus-5

# --- Voiceover --------------------------------------------------------------
# AUTOREELS_TTS: auto | elevenlabs | openai | none
AUTOREELS_TTS=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=

# --- Render -----------------------------------------------------------------
AUTOREELS_FONT=DejaVu Sans
AUTOREELS_MUSIC_VOLUME=0.12

# --- Image-to-video (optional) ----------------------------------------------
# Animates your real product photos into short clips instead of Ken Burns pans.
# Billed per clip, so autoreels only animates what you ask for: --animate hook.
# AUTOREELS_VIDEO: auto | runway | fal | none
AUTOREELS_VIDEO=auto

# Runway (Gen-4 family)
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=720:1280

# Kling, hosted on fal.ai
FAL_API_KEY=
FAL_MODEL=fal-ai/kling-video/v1/standard/image-to-video
FAL_ASPECT_RATIO=9:16

# Both services rename models regularly. When a job is rejected with an unknown
# model error, check the provider's current docs and set the value above. No
# code change needed.
